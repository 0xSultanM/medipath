  "typography": {
    "font-family": {
      "base": "'Inter', 'Manrope', system-ui, -apple-system, 'Segoe UI', sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace"
    },
    "font-weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "scale": {
      "display": { "size": "36px", "line": "44px", "weight": 700, "usage": "Marketing hero only (H1 at 1440)" },
      "h1": { "size": "32px", "line": "40px", "weight": 700, "usage": "Page title (H1 32/40 bold per brief)" },
      "h2": { "size": "24px", "line": "32px", "weight": 600, "usage": "Section title" },
      "h3": { "size": "20px", "line": "28px", "weight": 600, "usage": "Card title / modal title" },
      "h4": { "size": "18px", "line": "26px", "weight": 600, "usage": "Subsection" },
      "body-lg": { "size": "18px", "line": "28px", "weight": 400, "usage": "Lead paragraphs" },
      "body": { "size": "16px", "line": "24px", "weight": 400, "usage": "Default (body 16/24 per brief)" },
      "sm": { "size": "14px", "line": "20px", "weight": 400, "usage": "Table cells, secondary UI" },
      "caption": { "size": "13px", "line": "18px", "weight": 400, "usage": "Meta, timestamps (caption 13/18 per brief)" },
      "micro": { "size": "12px", "line": "16px", "weight": 500, "usage": "Badge text, uppercase labels — never on tint backgrounds below 440px viewport" },
      "kpi-value": { "size": "28px", "line": "34px", "weight": 700, "usage": "KPI number, tabular-nums" },
      "money": { "size": "inherit", "line": "inherit", "weight": 600, "feature": "font-variant-numeric: tabular-nums", "usage": "All {{CURRENCY}} amounts and IDs" }
    }
  },
  "spacing": {
    "grid": "8pt",
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "base": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px",
    "3xl": "64px",
    "4xl": "96px"
  },
  "radius": {
    "input": "8px",
    "card": "12px",
    "pill": "999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(11,37,69,0.06)",
    "md": "0 4px 12px rgba(11,37,69,0.08)",
    "lg": "0 12px 32px rgba(11,37,69,0.14)",
    "dark-md": "0 4px 12px rgba(0,0,0,0.45)",
    "dark-lg": "0 12px 32px rgba(0,0,0,0.55)"
  },
  "breakpoint": {
    "xs": "0",
    "sm": "640px — table→card conversion threshold",
    "md": "768px — navbar/sidebar→slide-over drawer threshold",
    "lg": "992px — doctor grid 3-col, fixed sidebar",
    "xl": "1200px",
    "2xl": "1440px — design canvas width",
    "renderWidths": ["360px", "768px", "1440px"]
  },
  "sizing": {
    "touch-target": "44px",
    "control-height": "44px",
    "icon": "20px",
    "avatar-sm": "32px",
    "avatar-md": "48px",
    "avatar-lg": "88px",
    "navbar-h": "64px",
    "sidebar-w": "264px",
    "chatbot-fab": "56px",
    "drawer-max": "min(340px, 86vw)"
  },
  "zIndex": {
    "dropdown": 1000,
    "drawer-backdrop": 1050,
    "drawer": 1060,
    "modal-backdrop": 1090,
    "modal": 1100,
    "toast": 1200,
    "chatbot": 1250
  },
  "motion": {
    "fast": "120ms ease-out",
    "base": "220ms ease-in-out",
    "pulse": "1.4s ease-in-out infinite (current stepper step, saving spinner)",
    "shimmer": "1.6s linear infinite (skeleton only — respects prefers-reduced-motion)"
  }
}
