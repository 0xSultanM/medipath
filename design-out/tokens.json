{
  "$schema": "https://design.sentry/mediapp/tokens.schema.json",
  "name": "MediPath Design Tokens",
  "version": "1.0.0",
  "date": "2026-11-23",
  "source": "Docs/MEDIPATH_DEVELOPMENT_PLAN.md §5 + FIGMA_MAKE_PROMPT.md §1 + project brief (Mandatory Design System)",
  "meta": {
    "currency": "{{CURRENCY}}",
    "currencyNote": "Money is NEVER rendered with a literal '$'. The runtime symbol is injected from the Admin-managed global currency setting (settings.currency_code) via CurrencyFormatter. Tabular numerals for all money/IDs.",
    "fontNote": "Inter with Manrope fallback; system-ui last resort. Font family is a token, not hardcoded per screen.",
    "roleNote": "Role labels and specialty names are data-driven (users.role enum, specialties table). No component may hardcode them; they arrive via slot/prop bindings.",
    "emergencyScope": "color.emergency (#B91C1C) is reserved EXCLUSIVELY for emergency-red-flag UI (escalation modal, in-stream chat alert, emergency page, hotline CTAs, red-flag banners). Routine destructive/error UI uses color.danger (#DC2626).",
    "themeMechanism": "One variable collection with two modes (Theme=Light, Theme=Dark) — mirrors Figma variable modes; implemented as :root + [data-theme=dark] custom properties. Prototypes toggle via #mp-theme checkbox (:root:has())."
  },
